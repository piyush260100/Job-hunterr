# ===== Core (required) =====
MONGODB_URI=
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ===== Corporate network (optional) =====
# Fix for "UNABLE_TO_GET_ISSUER_CERT_LOCALLY" behind a TLS-intercepting proxy.
# Point to your company's root CA bundle (PEM). Node reads this natively.
NODE_EXTRA_CA_CERTS=
# Explicit outbound proxy, e.g. http://proxy-host:8080 (credentials allowed in URL).
HTTPS_PROXY=

# ===== Job sources (optional; absent => source auto-disabled) =====
# Adzuna: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Jooble: https://jooble.org/api/about
JOOBLE_API_KEY=

# Generic RSS/Atom career feeds (comma-separated URLs)
RSS_FEED_URLS=

# LinkedIn OFFICIAL Partner API (https://learn.microsoft.com/linkedin/).
# Requires LinkedIn Partner Program approval for a jobs product. All four needed to
# enable; absent => the LinkedIn source stays disabled (no scraping ever).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_BASE_URL=

# Remotive requires no key and is enabled by default.

# ===== LLM for tailored documents (optional; absent => tailoring disabled) =====
LLM_PROVIDER=
LLM_API_KEY=

# ===== Notifications (optional; absent => dashboard-only) =====
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
